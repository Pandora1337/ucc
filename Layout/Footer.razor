@using ucc.Models.Settings

<footer class="mb-3">
    <hr class="border-secondary m-0 mb-3">

    <div class="d-grid mb-2" style="grid-template-columns: 1fr auto 1fr; align-items: center;">
        <div class="text-end">
            <a href="@featureReqUrl" target="_blank" class="text-muted text-decoration-none">
                Request Feature
            </a>
        </div>

        <div class="px-2">
            &middot;
        </div>

        <div>
            <a href="@reportBugUrl" target="_blank" class="text-muted text-decoration-none">
                Report Bug
            </a>
        </div>
    </div>

    <div class="d-grid" style="grid-template-columns: 1fr auto 1fr; align-items: center;">
        <div />

        <div class="d-flex gap-3 fs-5">
            <a href="@repo" target="_blank" class="text-secondary" aria-label="GitHub">
                <i class="bi bi-github" />
            </a>

            <a href="@discord" target="_blank" class="text-secondary" aria-label="Discord">
                <i class="bi bi-discord" />
            </a>
        </div>

        <a href="@($"{repo}/releases/tag/{version}")" target="_blank"
           class="text-end text-muted font-monospace small me-3" aria-label="app version">
            @version
        </a>
    </div>
</footer>

@code {
    private readonly static string version = VersionParser.GetAppVersion();
    private readonly static string repo = "https://github.com/Pandora1337/ucc";
    private readonly static string featureReqUrl = $"{repo}/issues/new?labels=enhancement&template=feature-request---.md";
    private readonly static string reportBugUrl = $"{repo}/issues/new?labels=bug&template=bug-report---.md";
    private readonly static string discord = "https://discord.com/users/280299811310272513";
}