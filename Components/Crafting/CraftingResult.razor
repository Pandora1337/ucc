@using ucc.Models
@using ucc.Models.Crafting
@using ucc.Models.Solver;
@using ucc.Components.Accordion
@using ucc.Components.Alert

@namespace ucc.Components.Crafting

@inject ucc.Services.InventoryService IS
@inject ucc.Data.LocalStorage LS;

@if (CraftingData.Status != Simplex.Status.SUCCESS)
{
    <Alert Title="@CraftingData.Status.ToString()" Message="@CraftingData.ErrorMessage" />
    return;
}

<Accordion>
    <AccordionItem Icon="bi-list" Title="Item List" OpenOnStart="true">
        @if (CraftingData.ItemsProd.Count > 0)
        {
            <div class="mb-2 fw-bold">
                <i class="bi bi-gem me-2" aria-hidden="true" />Products:
            </div>
            <ItemBadgeList Items="CraftingData.ItemsProd" />
        }

        @if (CraftingData.ItemsInt.Count > 0)
        {
            <div class="my-2 fw-bold">
                <i class="bi bi-layers-half me-2" aria-hidden="true" />Intermediate:
            </div>
            <ItemBadgeList Items="CraftingData.ItemsInt" />
        }

        <div class="my-2 fw-bold">
            <i class="bi bi-minecart-loaded me-2" aria-hidden="true" />Raw:
        </div>
        <ItemBadgeList Items="CraftingData.ItemsRaw" />
    </AccordionItem>
</Accordion>

<div class="d-flex justify-content-between mt-lg-3 @(CraftingData.CraftingTime > 0 ? "mt-3" : "")">
    <h5 class="mb-0 align-self-center">
        @if (CraftingData.CraftingTime > 0)
        {
            <span title="Time, in seconds, to craft each recipe sequentially">
                Total Crafting Time:
                <i class="bi bi-clock ms-2 me-1" aria-hidden="true" />
                @(CraftingData.CraftingTime)s
            </span>
        }
    </h5>

    <div class="btn-group d-none d-lg-inline-flex" role="group">
        <input type="radio" class="btn-check" id="viewGrid" name="viewMode" @onchange="ToggleRecipeGrid"
               checked="@(IsGridView)" />
        <label class="btn btn-outline-secondary" for="viewGrid" title="Grid View">
            <i class="bi bi-grid" aria-label="Grid View" />
        </label>

        <input type="radio" class="btn-check" id="viewList" name="viewMode" @onchange="ToggleRecipeGrid"
               checked="@(!IsGridView)" />
        <label class="btn btn-outline-secondary" for="viewList" title="List View">
            <i class="bi bi-view-stacked" aria-label="List View" />
        </label>
    </div>
</div>

<div class="row">
    @for (int i = 0; i < CraftingData.RecipeGuideList.Count; i++)
    {
        (Guid guid, float ops) = CraftingData.RecipeGuideList.ElementAt(i);
        Recipe recipe = IS.GetRecipeById(guid);

        <div @key="guid.ToString() + ops" class="mt-3 col-12 
            @(IsGridView && CraftingData.RecipeGuideList.Count > 1 ? "col-lg-6" : "")
            @(IsGridView && CraftingData.RecipeGuideList.Count > 2 ? "col-xxl-4" : "")">

            @if (recipe != null)
            {
                var timeScale = Rate == CraftingRate.PerMin ? 60 : 1;
                <CraftingStep Recipe="recipe" Operations="ops / timeScale" OrderNum="i + 1"
                              IsInvalid="@(!recipe.IsOutdated(CraftingData.DateCrafted))" />
            }
            else
            {
                <CraftingStep IsInvalid="true" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public required CraftingData CraftingData { get; set; }
    [Parameter] public required CraftingRate Rate { get; set; }
    private bool IsGridView { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsGridView = await LS.Get<bool>("craftingPageIsGridView");
    }

    private async Task ToggleRecipeGrid()
    {
        IsGridView = !IsGridView;
        await LS.Set("craftingPageIsGridView", IsGridView);
    }
}