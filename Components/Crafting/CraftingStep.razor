@using ucc.Models
@using ucc.Components.Item

@namespace ucc.Components.Crafting

@if (Recipe == null)
{
    <div class="card p-3 position-relative border-danger @Class">
        <span class="text-danger text-center">
            <span class="visually-hidden">Error: </span>
            Recipe is no longer available :(
        </span>
    </div>
    return;
}

<div class="card p-3 position-relative @(IsInvalid ? "border-danger" : "") @Class">
    @if (OrderNum > -1)
    {
        <span
            class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-primary d-flex justify-content-center align-items-center"
            style="width: 24px; height: 24px;" title="Crafting Order">
            @OrderNum
        </span>
    }

    <div class="position-absolute end-0 top-0 d-flex justify-content-center align-items-center">
        @if (IsInvalid)
        {
            <div class="mx-2 mt-1" title="This recipe has been modified, and needs re-crafting to update!">
                <i class="bi bi-exclamation-circle text-danger" aria-hidden="true" />
            </div>
        }

        <div class="px-2 py-1 text-bg-secondary ops-label" title="How many times this recipe is used">
            x@(float.Round(Operations, 2))
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Recipe.Name))
    {
        <span class="text-center text-truncate fw-bold card-title" title="@Recipe.Name">
            @Recipe.Name
        </span>
    }

    <div class="d-flex flex-wrap gap-1 justify-content-center">
        @for (int i = 0; i < Recipe.Ingredients.Count; i++)
        {
            (string itemId, float amount) = Recipe.Ingredients[i];
            <ItemBadge @key="itemId + amount + i" ItemId="@itemId" Amount="@(amount)" style="max-width: 49%;" />
        }
    </div>

    <div class="row g-0 py-2">
        <div class="col-5 d-flex justify-content-end align-items-center">
            @if (Recipe.BatchSize > 0)
            {
                @if (OrderNum > -1)
                {
                    int batches = (OperationsInt / (int)Recipe.BatchSize);
                    int mod = OperationsInt % (int)Recipe.BatchSize;
                    <span title="Number of full batches, batch size, and the size of the incomplete batch">
                        @batches x
                        <i class="bi bi-stack" aria-hidden="true" />
                        @Recipe.BatchSize
                        @if (mod > 0)
                        {
                            <span> (+@(mod))</span>
                        }
                    </span>
                }
                else
                {
                    <span title="Batch size">
                        <i class="bi bi-stack mx-1" aria-hidden="true" />
                        @Recipe.BatchSize
                    </span>
                }
            }
        </div>

        <div class="col-2">
            @if (!string.IsNullOrEmpty(Recipe.StationId))
            {
                <i class="bi bi-caret-down-fill d-block text-center" aria-hidden="true" />
                <div class="text-center position-relative d-block mx-auto" style="width: 32px;">
                    <ItemIcon @key="Recipe.StationId" ItemId="@Recipe.StationId" Size="32px" />
                </div>
                <i class="bi bi-caret-down-fill d-block text-center" aria-hidden="true" />
            }
            else
            {
                <i class="bi bi-caret-down-fill d-block text-center" title="Crafts into" style="font-size: 32px;" />
            }

        </div>

        <div class="col-5 d-flex justify-content-start align-items-center">
            @if (Recipe.CraftingTime > 0)
            {
                <span title="Crafting Time">
                    <i class="bi bi-clock" aria-hidden="true" />
                    @(Recipe.GetTotalCraftingTime(OperationsInt))s
                </span>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap gap-1 justify-content-center">
        @for (int i = 0; i < Recipe.Products.Count; i++)
        {
            (string itemId, float amount) = Recipe.Products[i];
            <ItemBadge @key="itemId + amount + i" ItemId="@itemId" Amount="@(amount)"
                       style="max-width: 100%;" />
        }
    </div>
</div>

@code {
    [Parameter] public Recipe Recipe { get; set; } = default!;
    [Parameter] public float Operations { get; set; } = 1;
    [Parameter] public string Class { get; set; } = "bg-body-tertiary";
    [Parameter] public int OrderNum { get; set; } = -1;

    [Parameter] public bool IsInvalid { get; set; } = false;

    private int OperationsInt => (int)float.Ceiling(Operations);
}
