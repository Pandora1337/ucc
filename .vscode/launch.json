{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach",
            "type": "blazorwasm",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "url": "http://localhost:5153",
            "browser": "chrome",
            "timeout": 60000,
        },
        {
            "name": "Watch",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch",
                "--verbose",
                "--non-interactive",
            ],
            "cwd": "${workspaceFolder}",
            // "console": "internalConsole",
            "console": "integratedTerminal",
            // "postDebugTask": "Kill Dotnet"
        },
    ],
    "compounds": [
        {
            "name": "Watch + Attach Blazor WASM",
            "configurations": [
                "Watch",
                "Attach",
            ],
            "presentation": {
                "group": "",
                "order": 1
            }
        }
    ]
}