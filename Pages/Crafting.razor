@page "/crafting"

@using System.Threading.Tasks
@using ucc.Components.Alert
@using ucc.Components.BtnAdd
@using ucc.Components.BtnDelete
@using ucc.Components.Crafting
@using ucc.Components.Item
@using ucc.Components.Recipe
@using ucc.Components.Modal
@using ucc.Components.InputMath
@using ucc.Components.Tab
@using ucc.Models
@using ucc.Models.Crafting

@implements IDisposable

@inject ucc.Services.CraftingService CS

<PageTitle>Crafting Calculator</PageTitle>

<h1 class="text-center">Crafting Calculator</h1>

<div class="d-flex justify-content-between mb-2 border border-0 border-3 border-bottom">
    <h3 class="mb-1">Planned crafts:</h3>

    <button class="btn btn-sm btn-danger h-100" @onclick="DeletePlannedCrafts" title="Clear Planned Crafts">
        <i class="bi bi-trash3" aria-label="Clear Planned Crafts" />
    </button>
</div>

<div class="d-grid justify-content-center g-3 gap-3 mb-3" style="grid-template-columns: repeat(auto-fit, 128px);">
    <div class="me-3">
        <BtnAdd OnClicked="OpenItemPicker" style="width: 128px; min-height: 200px; height: 100%;" />
    </div>

    @foreach (Ingredient ing in plannedCrafts)
    {
        <ItemCard @key="ing.GetHashCode()" ItemId="@ing.ItemId" IconSize="128px" style="max-width: 128px;"
                  OnItemClicked="@(() => OnItemDeleted(ing))" cClass="position-relative">
            <BtnDelete OnDelete="@(() => OpenAddRecipeModal(ing.ItemId))" ImgSrc="bi-journal-plus"
                       cClass="btn-outline-warning" Title="Create recipe for this item" style="top: 88px;" />
            <InputMath Class="mt-3" Value="@ing.Amount"
                       ValueChanged="@(async (v) => { ing.Amount = v; await UpdatePlannedCrafts(); })" />
        </ItemCard>
    }
</div>


<Modal @ref="modalItemPick" Title="Choose an Item to craft" CanScroll="false">
    <div class="modal-body pb-0 px-0">
        <ItemPicker OnItemPicked="OnItemPicked" />
    </div>
</Modal>

<Modal @ref="modalAddRecipe" Title="Add New Recipe">
    <div class="modal-body">
        <RecipeForm OnRecipeAdd="OnRecipeAdded" recipe="modalRecipe" />
    </div>
</Modal>

@* 
Cant check for `cd == null` here: null happens when no recipes are found in the graph
And if you hide the tabs, you hide the filter tab that exposes recipes to the search
*@

@if (plannedCrafts.Count == 0)
    return;

<div class="text-center mb-3">
    <div class="btn-group" role="group">
        <input type="radio" class="btn-check" name="crafting-rate" id="rateOnce" autocomplete="off"
               checked="@(cp.Rate == CraftingRate.Once)" @onchange="@(() => SelectRate(CraftingRate.Once))">
        <label class="btn btn-outline-secondary" for="rateOnce" title="One Time">
            <i class="me-2 bi bi-circle-fill" aria-label="One Time" />Once
        </label>

        <input type="radio" class="btn-check" name="crafting-rate" id="rateSec" autocomplete="off"
               checked="@(cp.Rate == CraftingRate.PerSec)" @onchange="@(() => SelectRate(CraftingRate.PerSec))" />
        <label class="btn btn-outline-secondary" for="rateSec" title="Per Second">
            <i class="me-2 bi bi-stopwatch-fill" aria-label="Per Second" />/sec
        </label>

        <input type="radio" class="btn-check" name="crafting-rate" id="rateMin" autocomplete="off"
               checked="@(cp.Rate == CraftingRate.PerMin)" @onchange="@(() => SelectRate(CraftingRate.PerMin))" />
        <label class="btn btn-outline-secondary" for="rateMin" title="Per Minute">
            <i class="me-2 bi bi-hourglass-split" aria-label="Per Minute" />/min
        </label>
    </div>
</div>

<TabList @ref="tabList" Class="mb-3">
    <Tab @ref="craftTab" Title="Crafting" Icon="@(CS.IsCrafting ? "spinner-border spinner-border-sm" : "bi-tools")"
         IsAlwaysRendered="true" OnActivated="TryCrafting">

        @if (cd != null)
        {
            <CraftingResult Rate="cp.Rate" CraftingData="cd" />
        }
        else
        {
            <Alert Class="alert-warning" Title="No recipes found!" Message="Adjust item selection or recipe filters" />
        }
    </Tab>

    <Tab Title="Cost" Icon="bi-coin">
        <div class="d-flex justify-content-between mb-2">
            <div>
                <h5 class="mb-1">Raw item costs</h5>
                <p class="mb-0 text-muted">
                    Higher cost means the calculator will try to use that item less.
                </p>
            </div>

            <button class="btn btn-sm btn-danger h-100 align-self-center" title="Clear All Costs"
                    @onclick="ClearParamsCosts">
                <i class="bi bi-trash3" aria-label="Clear All Costs" />
            </button>
        </div>

        <div class="row g-2">
            @foreach ((string itemId, float cost) in cp.Costs)
            {
                <div @key="itemId + cost" class="col-12 
                    @(cp.Costs.Count > 1 ? "col-lg-6" : "")
                    @(cp.Costs.Count > 2 ? "col-xxl-4" : "")">
                    <RecipeIngredient ItemId="@itemId" Quantity="@cp.Costs[itemId]" InputTitle="Cost" EnableBtn="true"
                                      QuantityChanged="@(async (v) => { cp.Costs[itemId] = v; await UpdateCraftingParams(); })"
                                      OnBtnClicked="@(async () => { cp.Costs.Remove(itemId); await UpdateCraftingParams(); })" />
                </div>
            }
        </div>
    </Tab>

    <Tab Title="Filter" Icon="bi-funnel-fill" IsAlwaysRendered="true">
        <h5 class="mb-1">Recipe filter</h5>
        <p class="mb-2 text-muted">
            Select what recipes are used in the calculator.
        </p>

        <RecipeFilter Blacklist="cp.Blacklist" OnBlacklistChanged="UpdateCraftingParams" />
    </Tab>
</TabList>

@code {
    private List<Ingredient> plannedCrafts => CS.PlannedCrafts;
    private CraftingData? cd => CS.CraftingData;
    private CraftingParams cp => CS.CraftingParams;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && cd == null)
            CS.RequestCrafting();

        TryCrafting();
    }

    protected override void OnInitialized()
    {
        CS.OnCraftingStatusChange += CraftingStatusChanged;
    }

    public void Dispose()
    {
        CS.OnCraftingStatusChange -= CraftingStatusChanged;
    }

    TabList tabList = null!;
    private void CraftingStatusChanged()
    {
        tabList?.UpdateState();
        StateHasChanged();
    }

    Tab craftTab = null!;
    private async void TryCrafting()
    {
        if (craftTab?.IsActive == true)
            await CS.Craft();
    }

    // Crafting Params
    private async Task SelectRate(CraftingRate rate)
    {
        // XOR: fire if either is true, but not both
        bool rateChanged = cp.Rate == CraftingRate.Once ^ rate == CraftingRate.Once;
        cp.Rate = rate;
        await CS.SaveCraftingParams();

        if (rateChanged)
            await SaveAndNotify(null);
    }

    private async void ClearParamsCosts()
    {
        cp.Costs.Clear();
        await UpdateCraftingParams();
    }

    // Modals
    private Modal modalAddRecipe = null!;
    private Recipe modalRecipe = null!;
    private async Task OpenAddRecipeModal(string itemId)
    {
        modalRecipe = new Recipe()
        {
            Products = [new(itemId)]
        };
        await modalAddRecipe.OpenAsync();
    }

    private async Task OnRecipeAdded()
    {
        await modalAddRecipe.CloseAsync();
        TryCrafting();
    }

    private Modal modalItemPick = null!;
    private async Task OpenItemPicker()
    {
        await modalItemPick.OpenAsync();
    }

    // Planned Crafts
    private async Task OnItemPicked(string itemId)
    {
        Ingredient? ing = plannedCrafts.FirstOrDefault(i => i.ItemId == itemId);
        if (ing == null)
        {
            plannedCrafts.Add(new(itemId));
        }
        else
        {
            ing.Amount += 1f;
        }

        await modalItemPick.CloseAsync();
        await UpdatePlannedCrafts();
    }

    private async Task OnItemDeleted(Ingredient ing)
    {
        plannedCrafts.Remove(ing);
        await UpdatePlannedCrafts();
    }

    private async Task DeletePlannedCrafts()
    {
        plannedCrafts.Clear();
        await UpdatePlannedCrafts();
    }

    private async Task UpdatePlannedCrafts() => await SaveAndNotify(CS.SavePlannedCrafts);

    private async Task UpdateCraftingParams() => await SaveAndNotify(CS.SaveCraftingParams);

    private async Task SaveAndNotify(Func<Task>? saveAction)
    {
        if (saveAction != null)
            await saveAction();

        CS.RequestCrafting();
        TryCrafting();
    }
}
