@page "/inventory"

@using ucc.Models
@using ucc.Components.Item;
@using ucc.Components.Recipe;
@using ucc.Components.BtnAdd;
@using ucc.Components.BtnDelete;
@using ucc.Components.Modal;
@using ucc.Components.Crafting
@using ucc.Components.Searchbar
@using ucc.Components.Tab
@using ucc.Components.SortSelect

@implements IDisposable

@inject ucc.Services.InventoryService IS;
@inject ucc.Services.IconService IconService;

<PageTitle>Inventory</PageTitle>

<h1 class="text-center">Inventory</h1>
<div class="w-100 text-center">
    <button class="btn btn-outline-secondary" type="button" @onclick="IS.GenerateStuff">Quickstart recipes</button>
    <a class="btn btn-outline-secondary" href="settings#config" title="Go to config Import/Export"
       aria-label="Go to config Import/Export">
        <span class="bi bi-upload me-2" aria-hidden="true" />/<span class="bi bi-download ms-2" aria-hidden="true" />
    </a>
</div>

<div class="container d-flex justify-content-center align-items-center px-0 py-3 w-100" style="max-width: 600px;">
    <Searchbar @ref="searchbar" OnSearch="DoSearch" />
</div>

<div class="col-12 col-lg-10 mx-auto">
    <TabList Class="border-0 px-0 py-3">
        <Tab Title="Recipes" Icon="bi-journal-text">
            <div class="d-flex justify-content-between mb-2 border border-0 border-3 border-bottom">
                <h2 class="mb-1">Recipes (@filteredRecipes.Count):</h2>

                <div class="d-flex" style="max-height: 32px;">
                    <SortSelect Id="inventoryRecipe" @bind-Value="recipeSort" @bind-IsAscending="IsAscendingRecipes"
                                OnChanged="DoRecipeSort" />

                    <button class="btn btn-sm btn-danger h-100" @onclick="@(() => modalDeleteRecipeList.OpenAsync())"
                            title="Delete All Recipes">
                        <i class="bi bi-trash3" aria-label="Delete All Recipes" />
                    </button>
                </div>
            </div>

            <div class="row g-3">
                <div class="card col-12 col-md-6 col-xxl-4 delete-target border-0">
                    <BtnAdd Class="w-100 h-100" style="min-width: 128px; min-height: 128px;"
                            OnClicked="@(async () => await OpenRecipeAddModal())" />
                </div>

                @foreach (Guid recipe in filteredRecipes)
                {
                    <div @key="recipe" class="col-12 col-md-6 col-xxl-4">
                        <RecipeCard RecipeId="@recipe" OnRecipeClick="@(async () => await OpenRecipeAddModal(recipe))">
                            <BtnDelete OnDelete="@(async () => await OpenRecipeAddModal(recipe))" style="right: 48px;"
                                       cClass="btn-primary" ImgSrc="bi-pencil-square" Title="Edit" />

                            <BtnDelete OnDelete="@(async () => await OpenRecipeDeleteModal(recipe))" ImgSrc="bi-trash3"
                                       cClass="btn-danger" />
                        </RecipeCard>
                    </div>
                }
            </div>
        </Tab>

        <Tab Title="Items" Icon="bi-gem">
            <div class="d-flex justify-content-between mb-2 border border-0 border-3 border-bottom">
                <h2 class="mb-1">Items (@(filteredItems.Count)):</h2>

                <div class="d-flex" style="max-height: 32px;">
                    <SortSelect Id="inventoryItem" @bind-Value="itemSort" @bind-IsAscending="IsAscendingItems"
                                OnChanged="DoItemSort" />

                    <button class="btn btn-sm btn-danger h-100" @onclick="@(() => modalDeleteItemList.OpenAsync())"
                            title="Delete All Items">
                        <i class="bi bi-trash3" aria-label="Delete All Items" />
                    </button>
                </div>
            </div>

            <div class="d-grid justify-content-center g-3 gap-3"
                 style="grid-template-columns: repeat(auto-fit, 128px);">
                <BtnAdd style="width: 128px; min-height: 200px; height: 100%;"
                        OnClicked="@(async () => await OpenItemAddModal())" />

                @foreach (string itemId in filteredItems)
                {
                    <ItemCard @key="itemId" ItemId="@itemId" IconSize="128px" cClass="position-relative"
                                EnableDate="true" OnItemClicked="@(async () => await OpenItemAddModal(itemId))">
                        <BtnDelete OnDelete="@(async () => await OpenItemDeleteModal(itemId))" ImgSrc="bi-trash3" />
                    </ItemCard>
                }
            </div>
        </Tab>
    </TabList>
</div>


<Modal @ref="modalAddItem" Title="Add New Item">
    <div class="modal-body">
        <ItemForm OnItemAdded="@modalAddItem.CloseAsync" Item="modalItem" />
    </div>
</Modal>

<Modal @ref="modalAddRecipe" Title="Add New Recipe">
    <div class="modal-body">
        <RecipeForm OnRecipeAdd="@modalAddRecipe.CloseAsync" recipe="modalRecipe" />
    </div>
</Modal>

<ModalDelete @ref="modalDeleteItem" Subject="this item" OnDelete="ItemRemove">
    <div class="text-center pt-2">
        <ItemBadge @key="modalItem.Id" Item="modalItem" />
    </div>

    @{
        List<Recipe> deleteRecipes = IS.GetRecipesWithItem(modalItem.Id).ToList();
    }
    @if (deleteRecipes.Count > 0)
    {
        <p class="mt-2 text-danger m-0">
            This item is part of the following recipes:
        </p>

        <ul class="list-group">
            @foreach (Recipe recipe in deleteRecipes)
            {
                <li class="list-group-item border-0 p-0 pt-3" @key="recipe.Guid">
                    <CraftingStep Recipe="recipe" />
                </li>
            }
        </ul>
    }
</ModalDelete>

<ModalDelete @ref="modalDeleteRecipe" Subject="this recipe" OnDelete="RecipeRemove">
    <CraftingStep Recipe="modalRecipe"/>
</ModalDelete>

<ModalDelete @ref="modalDeleteItemList" Subject="all items" OnDelete="@(async () => { await IS.ClearAllItems(); await IconService.ClearIcons(); })" />
<ModalDelete @ref="modalDeleteRecipeList" Subject="all recipes" OnDelete="@(async () => await IS.ClearAllRecipes())" />

@code {
    protected override void OnInitialized()
    {
        IS.OnRecipeListChange += Rescan;
        IS.OnItemListChange += Rescan;
        DoSearch("");
    }

    public void Dispose()
    {
        IS.OnRecipeListChange -= Rescan;
        IS.OnItemListChange -= Rescan;
    }

    private void Rescan()
    {
        DoSearch(searchbar.SearchString);
        StateHasChanged();
    }

    private Searchbar searchbar = null!;
    private List<string> searchItems = [];
    private List<Guid> searchRecipes = [];
    void DoSearch(string search)
    {
        searchItems = IS.SearchItemIds(search).ToList();
        DoItemSort();

        IEnumerable<Guid> byItem = IS.GetRecipesWithItems(searchItems);
        IEnumerable<Guid> byName = IS.SearchRecipeIdsByName(search);
        searchRecipes = byItem.Concat(byName).Distinct().ToList();
        DoRecipeSort();
    }

    private bool IsAscendingItems = true;
    private Services.InventoryService.ItemSort itemSort = Services.InventoryService.ItemSort.Name;
    private List<string> filteredItems = [];
    private void DoItemSort()
    {
        filteredItems = IS.DoItemIdSort(searchItems, itemSort, IsAscendingItems).ToList();
    }

    private bool IsAscendingRecipes = true;
    private Services.InventoryService.RecipeSort recipeSort = Services.InventoryService.RecipeSort.Date;
    private List<Guid> filteredRecipes = [];
    private void DoRecipeSort()
    {
        filteredRecipes = IS.DoRecipeIdSort(searchRecipes, recipeSort, IsAscendingRecipes).ToList();
    }

    private ModalDelete modalDeleteItemList = null!;
    private ModalDelete modalDeleteRecipeList = null!;

    private Item modalItem = null!;
    private Modal modalAddItem = null!;
    private async Task OpenItemAddModal(string item = "")
    {
        modalItem = string.IsNullOrEmpty(item) ? new(searchbar.SearchString) : IS.GetItem(item).Copy();
        await modalAddItem.OpenAsync();
    }

    private ModalDelete modalDeleteItem = null!;
    private async Task OpenItemDeleteModal(string item)
    {
        modalItem = IS.GetItem(item);
        await modalDeleteItem.OpenAsync();
    }

    private async Task ItemRemove()
    {
        bool resp = await IS.TryRemoveItem(modalItem.Id);
        if (!resp)
        {
            return;
        }

        await IconService.DeleteIcon(modalItem.Id);

        modalItem = null!;
    }

    private Recipe modalRecipe = null!;
    private Modal modalAddRecipe = null!;
    private async Task OpenRecipeAddModal(Guid? guid = null!)
    {
        modalRecipe = guid == null ? Recipe.GetNew() : IS.GetRecipeById(guid.Value).Copy();
        await modalAddRecipe.OpenAsync();
    }

    private ModalDelete modalDeleteRecipe = null!;
    private async Task OpenRecipeDeleteModal(Guid guid)
    {
        modalRecipe = IS.GetRecipeById(guid);
        await modalDeleteRecipe.OpenAsync();
    }

    private void RecipeRemove()
    {
        IS.TryRemoveRecipe(modalRecipe.Guid);
        modalRecipe = null!;
    }
}
